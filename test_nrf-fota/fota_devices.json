  "defaults": {
    "ssh_key": "D:\\FkDev\\cli_home\\.ssh\\id_ed25519",
    "target": "t1000e-200km",
    "sender": "companion",
    "delay": 5.0,
    "scope": "direct",
    "max_rounds": 12,
